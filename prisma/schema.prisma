generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model agent_journal {
  id         String  @id
  agent_id   String
  type       String  @default("thought")
  content    String
  context    String  @default("{}")
  mood_at    String?
  created_at String  @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  agents     agents  @relation(fields: [agent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([agent_id, created_at], map: "idx_journal_agent")
}

model agents {
  id             String          @id
  name           String
  type           String
  status         String          @default("offline")
  description    String          @default("")
  uptime         Float           @default(0) @db.Real
  task_count     Int             @default(0)
  success_rate   Float           @default(0) @db.Real
  last_heartbeat String?
  reflex_level   Int             @default(0)
  config         String          @default("{}")
  created_at     String          @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  updated_at     String          @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  agent_journal  agent_journal[]
  sub_agents     sub_agents[]
}

model ai_config {
  key        String @id
  value      String
  updated_at String @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model channel_accounts {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform        String
  label           String    @default("")
  session_enc     String
  status          String    @default("active")
  last_checked_at DateTime? @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([platform, status, created_at(sort: Desc)], map: "idx_channel_accounts_platform")
}

model crawl_results {
  id         String @id
  store_id   String
  store_name String @default("")
  platform   String @default("")
  url        String @default("")
  data       String @default("{}")
  timestamp  String @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))

  @@index([store_id], map: "idx_crawl_store")
  @@index([timestamp], map: "idx_crawl_time")
}

model evolution_records {
  id             String  @id
  stage          String
  title          String
  description    String  @default("")
  agent_id       String
  started_at     String  @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  completed_at   String?
  status         String  @default("in_progress")
  metrics        String?
  before_metrics String?
  source         String  @default("manual")
}

model memory_entries {
  id         String  @id
  zone       String
  title      String
  content    String
  type       String
  version    Int     @default(1)
  verified   Int     @default(0)
  tags       String  @default("[]")
  agent_id   String?
  created_at String  @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  updated_at String  @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))

  @@index([agent_id], map: "idx_memory_agent")
}

model orchestrator_sessions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title      String   @default("新会话")
  messages   Json     @default("[]")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([updated_at(sort: Desc)], map: "idx_orchestrator_sessions_updated")
}

model rak_conflicts {
  id            String  @id
  task_id       String
  agents        String  @default("[]")
  conflict_type String
  description   String  @default("")
  resolution    String?
  resolved_at   String?
  result        String?
  created_at    String  @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))

  @@index([task_id], map: "idx_rak_conflicts_task")
}

model rak_consensus_log {
  id          String  @id
  proposal_id String
  proposer    String
  voters      String  @default("[]")
  status      String  @default("pending")
  threshold   Float   @default(0.67) @db.Real
  result      String?
  created_at  String  @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  resolved_at String?
}

model rak_dag_nodes {
  id             String  @id
  task_id        String
  name           String
  type           String  @default("task")
  status         String  @default("pending")
  assigned_agent String?
  dependencies   String  @default("[]")
  config         String  @default("{}")
  result         String?
  started_at     String?
  completed_at   String?
  tasks          tasks   @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([task_id], map: "idx_rak_dag_task")
}

model rak_messages {
  id           String  @id
  from_agent   String
  to_agent     String
  type         String
  protocol     String  @default("rak-v1")
  payload      String  @default("{}")
  status       String  @default("pending")
  created_at   String  @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  delivered_at String?
  ttl          Int     @default(30000)

  @@index([status], map: "idx_rak_messages_status")
  @@index([to_agent], map: "idx_rak_messages_to")
}

model risk_events {
  id          String  @id
  level       String
  title       String
  description String  @default("")
  source      String  @default("")
  timestamp   String  @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  resolved    Int     @default(0)
  resolved_at String?
  actions     String  @default("[]")
}

model risk_isolation {
  id          Int    @id @default(autoincrement())
  label       String
  description String @default("")
  checked     Int    @default(0)
}

model schema_migrations {
  id         String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}

model wf_workflow_runs {
  id           String  @id
  workflow_id  String
  status       String  @default("running")
  steps        String  @default("[]")
  summary      String  @default("")
  created_by   String  @default("agent")
  started_at   String  @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  completed_at String?

  @@index([workflow_id, started_at], map: "idx_wf_workflow_runs_wf")
}

model agent_templates {
  id          String @id
  type        String
  name        String
  description String @default("")
  config      String @default("{}")
  sort        Int    @default(0)
  created_at  String @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))
}

model teams {
  id              String @id
  name            String
  goal            String @default("")
  leader_agent_id String?
  created_at      String @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  updated_at      String @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))

  @@index([leader_agent_id], map: "idx_teams_leader")
}

model team_members {
  team_id   String
  agent_id  String
  role      String @default("member")
  joined_at String @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))

  @@id([team_id, agent_id])
  @@index([agent_id], map: "idx_team_members_agent")
}

model sub_agents {
  id               String @id
  parent_id        String
  name             String
  status           String @default("offline")
  spawned_at       String @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  task_description String @default("")
  agents           agents @relation(fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([parent_id], map: "idx_sub_agents_parent")
}

model task_steps {
  id           String
  task_id      String
  name         String
  status       String  @default("pending")
  agent_id     String  @default("")
  sort_order   Int     @default(0)
  started_at   String?
  completed_at String?
  output       String?
  tasks        tasks   @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([id, task_id])
  @@index([task_id], map: "idx_task_steps_task")
}

model tasks {
  id              String          @id
  title           String
  description     String          @default("")
  status          String          @default("pending")
  priority        String          @default("medium")
  assigned_agents String          @default("[]")
  output          String?
  created_at      String          @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  updated_at      String          @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))
  completed_at    String?
  rak_dag_nodes   rak_dag_nodes[]
  task_steps      task_steps[]
}

model wf_ad_analyses {
  id           String @id
