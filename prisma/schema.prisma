model wf_workflow_specs {
  id           String   @id
  title        String
  goal         String
  spec         Json
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @db.Timestamptz(6)
  workspace_id String   @default("default-workspace")
  created_by   String   @default("self")

  @@index([updated_at(sort: Desc)], map: "idx_wf_workflow_specs_updated")
  @@index([workspace_id, updated_at(sort: Desc)], map: "idx_wf_workflow_specs_ws")
}

model wf_workflow_statuses {
  id           String  @id
  name         String
  href         String  @default("")
  status       String  @default("idle")
  last_run     String?
  run_count    Int     @default(0)
  success_rate Float   @default(0) @db.Real
  updated_at   String  @default(dbgenerated("to_char(now(), 'YYYY-MM-DD HH24:MI:SS'::text)"))
}
